#!/usr/bin/env bash
# Pre-push gate: the confidentiality sweep checks everything this push would
# publish (outgoing blobs, paths, commit and tag text, ref names) before
# anything leaves the machine. Git's arguments and ref lines pass straight
# through. Activate per clone:
#   git config core.hooksPath .githooks
exec bash "$(git rev-parse --show-toplevel)/memento/tools/confidentiality-sweep.sh" --pre-push "$@"
